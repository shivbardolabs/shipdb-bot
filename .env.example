# Aurora PostgreSQL connection string (via RDS Proxy)
DATABASE_URL=postgresql://user:password@rds-proxy-host:5432/shipos?sslmode=require

# Slack App credentials (from api.slack.com/apps)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret

# (Optional) Comma-separated Slack user IDs allowed to run raw SQL
SQL_ALLOWED_USER_IDS=

# (Optional) Secret for Vercel cron job authentication
CRON_SECRET=
