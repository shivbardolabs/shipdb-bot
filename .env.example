# ──────────────────────────────────────────────────────────────────
# ShipDB Bot — Environment Variables
#
# These secrets are managed through Infisical.
# Changes auto-sync to Vercel. Do NOT edit env vars directly
# in the Vercel dashboard — they will be overwritten.
#
# For local dev, use:  infisical run --env=dev -- npm run dev
# Or export:           infisical export --env=dev --format=dotenv > .env
# ──────────────────────────────────────────────────────────────────

# Aurora PostgreSQL connection strings — one per environment
# At minimum, set DATABASE_URL (used as prod fallback) or DATABASE_URL_PROD.
DATABASE_URL=postgresql://user:password@aurora-host:5432/shipos_prod?sslmode=no-verify
DATABASE_URL_PROD=postgresql://user:password@aurora-host:5432/shipos_prod?sslmode=no-verify
DATABASE_URL_STAGING=postgresql://user:password@aurora-host:5432/shipos_staging?sslmode=no-verify
DATABASE_URL_DEV=postgresql://user:password@aurora-host:5432/shipos_dev?sslmode=no-verify

# Slack App credentials (from api.slack.com/apps)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret

# (Optional) Comma-separated Slack user IDs allowed to run raw SQL
SQL_ALLOWED_USER_IDS=

# (Optional) Secret for Vercel cron job authentication
CRON_SECRET=
